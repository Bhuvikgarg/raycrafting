RAYCRAFTING_PORT=4173
RAYCRAFTING_ADMIN_PIN=change-this-before-production
RAYCRAFTING_DATA_DIR=./data
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAYCRAFTING_SUPPORT_EMAIL=raywithcharm@gmail.com
RAYCRAFTING_SUPPORT_PHONE=+91-your-support-number

GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Phone OTP sign-in via Twilio Verify (keep these only in Railway variables)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Transactional order emails (keep the API key only in Railway variables)
RESEND_API_KEY=
RAYCRAFTING_EMAIL_FROM=Raycrafting <orders@raycrafting.store>

# Shiprocket delivery (keep the token only in Railway/Vercel server variables)
SHIPROCKET_API_TOKEN=
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=20
SHIPROCKET_DEFAULT_BREADTH_CM=15
SHIPROCKET_DEFAULT_HEIGHT_CM=10
